# Mapbox (map rendering + Directions API)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Firebase Realtime Database (live session sync)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Web app ID (Project Settings → General → Your apps) — required for App Check
VITE_FIREBASE_APP_ID=1:000000000000:web:your_app_id

# Firebase App Check (reCAPTCHA Enterprise)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# Google Places API (New) — optional, enables venue search near midpoint.
# Intentionally left unset in production (Places is billable), so venue search is
# off by design. The app degrades silently — no venues, no error — so an empty
# venue list is expected behavior, not a regression.
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Sentry — optional, enables production error tracking
VITE_SENTRY_DSN=
