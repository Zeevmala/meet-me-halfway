# Mapbox (map rendering + Directions API)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Firebase Realtime Database (live session sync)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase App Check (reCAPTCHA Enterprise) — optional, and all-or-nothing.
# Both together turn attestation on; neither turns it off. One without the other
# fails the build: the token exchange posts to /apps/{appId}/… and can only 400
# without the app resource, so a lone site key ships a client that cannot attest
# while looking configured.
#
# Both are intentionally unset in production as of 2026-09-18 — enforcement was
# never on and only 11% of requests verified, so it bought nothing. Access
# control is infra/database.rules.json.
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=

# Google Places API (New) — optional, enables venue search near midpoint.
# Intentionally left unset in production (Places is billable), so venue search is
# off by design. The app degrades silently — no venues, no error — so an empty
# venue list is expected behavior, not a regression.
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Sentry — optional, enables production error tracking
VITE_SENTRY_DSN=
