# Local, credential-free configuration: `--mode emulator`.
#
# Every value here is fake by design. The point of this file is that the whole
# app runs — create, join, slot claim, midpoint, snap-back — against the
# Realtime Database emulator with no Firebase project, no Mapbox account and no
# network. Committed deliberately: a local loop nobody can start is a local loop
# nobody uses, and until this existed the only way to exercise a two-party
# session was to deploy and message a friend.
#
# Used by `npm run dev:local` and `npm run test:e2e:local`.

# The SDK connects to the emulator when databaseURL is http:// on a local host;
# `ns` names the emulated namespace. No connectDatabaseEmulator call needed.
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-meet-me-halfway

# `demo-` prefixed project ids make the emulator refuse to reach real services.
VITE_FIREBASE_PROJECT_ID=demo-meet-me-halfway
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=fake.firebaseapp.com

# Mapbox is stubbed by the Playwright route handlers; the token only has to be
# present and well-formed enough for mapbox-gl to initialise.
VITE_MAPBOX_TOKEN=pk.fake_for_local

# validateAppConfig requires this, but VITE_FIREBASE_APP_ID is deliberately
# left unset: App Check needs both, so createAppCheck returns null and
# primeAppCheck resolves `no-appcheck` immediately instead of spending
# APP_CHECK_TIMEOUT_MS waiting for a reCAPTCHA that cannot load offline.
VITE_RECAPTCHA_SITE_KEY=fake-recaptcha-site-key
