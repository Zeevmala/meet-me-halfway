# Loaded by `vite build --mode e2e` and `vite preview --mode e2e` only.
#
# Fake credentials: the e2e suite answers Mapbox and Firebase Auth itself
# (e2e/helpers/) and talks to a local Realtime Database emulator, so nothing
# here reaches a real service. Committed on purpose — CI and a fresh clone
# build the same bundle the tests ran against.

VITE_MAPBOX_TOKEN=pk.fake_for_e2e
VITE_FIREBASE_API_KEY=fake-key
VITE_FIREBASE_AUTH_DOMAIN=demo-meet-me-halfway.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-meet-me-halfway
VITE_FIREBASE_DATABASE_URL=https://demo-meet-me-halfway-default-rtdb.firebaseio.com
VITE_RECAPTCHA_SITE_KEY=fake-recaptcha

# No VITE_FIREBASE_APP_ID, so App Check is skipped rather than failing against
# a reCAPTCHA the test cannot pass. No Places key: venue search stays off.

# The emulator the suite runs under (`firebase emulators:exec --only database`).
# validateAppConfig refuses this in a production-mode build.
VITE_RTDB_EMULATOR_HOST=127.0.0.1:9000
