{
  "rules": {
    "probe": {
      ".read": "auth != null"
    },
    "sessions": {
      "$code": {
        ".validate": "$code.matches(/^[2-9A-HJKMNP-Z]{6}$/)",
        "created": {
          ".read": "auth != null && data.val() > now - 86400000",
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "creatorUid": {
          ".read": "auth != null && data.parent().child('created').val() > now - 86400000",
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "slots": {
          ".read": "auth != null && data.parent().child('created').val() > now - 86400000",
          "0": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid && newData.val() === newData.parent().parent().child('creatorUid').val() && newData.parent().parent().child('created').val() > now - 86400000"
          },
          "1": {
            ".write": "auth != null && !data.exists() && root.child('sessions').child($code).child('created').val() > now - 86400000",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "2": {
            ".write": "auth != null && !data.exists() && root.child('sessions').child($code).child('created').val() > now - 86400000",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "3": {
            ".write": "auth != null && !data.exists() && root.child('sessions').child($code).child('created').val() > now - 86400000",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "4": {
            ".write": "auth != null && !data.exists() && root.child('sessions').child($code).child('created').val() > now - 86400000",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": { ".validate": false }
        },
        "participants": {
          ".read": "auth != null && data.parent().child('created').val() > now - 86400000 && (data.parent().child('slots/0').val() === auth.uid || data.parent().child('slots/1').val() === auth.uid || data.parent().child('slots/2').val() === auth.uid || data.parent().child('slots/3').val() === auth.uid || data.parent().child('slots/4').val() === auth.uid)",
          "$slot": {
            ".write": "auth != null && root.child('sessions').child($code).child('slots').child($slot).val() === auth.uid && (!newData.exists() || (root.child('sessions').child($code).child('created').val() > now - 86400000 && (!data.exists() || (newData.child('lat').val() === data.child('lat').val() && newData.child('lng').val() === data.child('lng').val()) || newData.child('ts').val() > data.child('ts').val() + 2000)))",
            ".validate": "newData.hasChildren(['uid', 'lat', 'lng', 'accuracy', 'ts'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "ts": { ".validate": "newData.isNumber() && newData.val() === now" },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
