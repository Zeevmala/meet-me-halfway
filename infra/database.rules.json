{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null && data.child('created').val() > now - 86400000",
        "created": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "creatorUid": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "slots": {
          "0": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid && newData.val() === root.child('sessions').child($code).child('creatorUid').val()"
          },
          "1": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "2": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "3": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "4": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": { ".validate": false }
        },
        "participants": {
          "$slot": {
            ".write": "auth != null && root.child('sessions').child($code).child('slots').child($slot).val() === auth.uid && (!newData.exists() || !data.exists() || (newData.child('lat').val() === data.child('lat').val() && newData.child('lng').val() === data.child('lng').val()) || newData.child('ts').val() > data.child('ts').val() + 2000)",
            ".validate": "newData.hasChildren(['uid', 'lat', 'lng', 'accuracy', 'ts'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "lat": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },
            "lng": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },
            "accuracy": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "ts": { ".validate": "newData.isNumber()" },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
